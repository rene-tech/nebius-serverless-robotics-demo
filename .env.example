SERVER_PORT=8787
DEMO_MODE=offline

# Live Nebius Serverless AI endpoint configuration.
# These values are read only by the backend proxy.
NEBIUS_ENDPOINT_URL=
NEBIUS_ENDPOINT_PATH=/v1/robotics/plan
NEBIUS_ENDPOINT_TOKEN=
NEBIUS_MODEL_IMAGE=registry.example.com/robotics/cosmos-reason:demo
NEBIUS_GPU_CLASS=GPU-backed Serverless AI endpoint
NEBIUS_SHM_SIZE=16Gi

# Keep true for event safety: live failures fall back to replay output.
ALLOW_FALLBACK_ON_ERROR=true
COLD_START_THRESHOLD_MS=2500

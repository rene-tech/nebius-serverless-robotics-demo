FROM caddy:2-alpine AS caddy

FROM node:22-slim AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM deps AS build
WORKDIR /app
COPY . .
RUN npm run build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY server ./server
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY deploy/start-tls.sh /usr/local/bin/start-tls.sh
RUN chmod +x /usr/local/bin/start-tls.sh
EXPOSE 80 443
CMD ["/usr/local/bin/start-tls.sh"]
